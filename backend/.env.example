# Comma-separated list of allowed frontend origins ("*" for dev)
CORS_ORIGINS=*
# Local SQLite; set DATABASE_URL to your hosted PostgreSQL URL in deployment.
DATABASE_URL=sqlite:///./fireflies.db
# Optional: enables real LLM answers in "Ask AI" (falls back to retrieval if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash